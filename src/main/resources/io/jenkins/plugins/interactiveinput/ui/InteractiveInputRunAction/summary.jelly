<?jelly escape-by-default='true'?>
<!--
  Build main-page summary contribution (review item B5). Included by BOTH run layouts inside a <table>:
  the classic page (hudson/model/Run/index.jelly, the "Build Artifacts" summaries table) and the new
  experimental run overview (jenkins/run/OverviewTab/index.jelly, inside its "Legacy" card table).
  Everything here is therefore emitted as table rows (<tr>) so it stays valid markup in both.

  bell.js is already loaded on every page for Overall/Read viewers via the NotificationBell page
  decorator (header.jelly), so this file adds NO adjunct of its own (a <script> is not valid mid-table).

  This renders the attention indicator — a native summary row (matching core's <t:summary> markup) shown
  only when the operator ticked "alert user on run page" in Configure. It starts hidden via jenkins-hidden
  unless the build is already waiting, so bell.js can reveal/hide it live as the scoped waiting count
  changes (the same no-reload behaviour as the inline job-page box). Clicking it opens the waiting
  question(s) in the shared dialog.

  The auto-open dialog controller and the live sidebar count controller are NOT emitted here: they are
  emitted by the NotificationBell page decorator (footer.jelly) so they reach the Console Output page and
  every run sub-page, which this main-page-only summary cannot.
-->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <j:if test="${it.runAlertEnabled}">
    <j:set var="iiRunBoxHidden" value="${it.waiting ? '' : 'jenkins-hidden'}"/>
    <tr class="app-summary ii-runbox-row ${iiRunBoxHidden}">
      <td>
        <l:icon src="${it.iconClassName}"/>
      </td>
      <td style="vertical-align:middle">
        <a href="${rootURL}/${it.run.url}interactive-input/"
           class="ii-runbox"
           data-ii-runbox="build"
           data-root-url="${rootURL}"
           data-job="${it.jobFullName}"
           data-build="${it.buildNumber}"
           data-poll-seconds="${it.pollingIntervalSeconds}"
           data-rich-modal="${it.richModalEnabled}">Interactive input needed — click to answer</a>
      </td>
    </tr>
  </j:if>
</j:jelly>
