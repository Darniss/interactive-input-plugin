<?jelly escape-by-default='true'?>
<!--
  Functional feature toggles for Interactive Input, rendered under Manage Jenkins -> System via
  <f:property field="features"/> in InteractiveInputGlobalConfig/config.jelly. Notification-surface
  look-and-feel (bell, per-project centre, job-page box, icon) lives separately under Appearance.

  Note: unchecked checkboxes are omitted from the submitted form, so InteractiveInputGlobalConfig#
  configure() starts the flags all-off before binding; the checked ones are then re-enabled here.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <f:entry>
    <f:checkbox field="askInteractiveStep" title="askInteractive pipeline step" default="true"/>
    <f:description>
      The durable human-in-the-loop askInteractive step. On by default.
    </f:description>
  </f:entry>

  <f:entry>
    <f:checkbox field="richModal" title="Rich in-page modal" default="true"/>
    <f:description>
      Answer questions in an in-page modal (markdown context, choices, free-text preview). When off,
      surfaces fall back to the built-in input page. On by default.
    </f:description>
  </f:entry>

  <f:entry>
    <f:checkbox field="restApi" title="REST API" default="true"/>
    <f:description>
      Expose the JSON API under /interactive-input/api/v1 (also used by the bell and per-project
      surfaces). On by default.
    </f:description>
  </f:entry>

  <f:entry>
    <f:checkbox field="inputStepBridge" title="Bridge built-in input steps"/>
    <f:description>
      Mirror pending built-in <code>input</code> steps into the notification surfaces (bell,
      per-project box, sidebar and build-list badge) and forward answers back to them. Off by default;
      turn it on to surface native <code>input</code> without changing your pipelines.
    </f:description>
  </f:entry>

  <f:entry>
    <f:checkbox field="dashboardTile" title="Dashboard tile"/>
    <f:description>
      Reserved for a future dashboard summary tile. Off by default.
    </f:description>
  </f:entry>

</j:jelly>
