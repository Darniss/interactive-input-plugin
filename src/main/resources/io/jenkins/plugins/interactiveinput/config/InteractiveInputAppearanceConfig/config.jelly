<?jelly escape-by-default='true'?>
<!--
  Renders under Manage Jenkins -> Appearance -> "Interactive Input" (this config's category is
  AppearanceCategory). Three independent on/off switches plus the icon chooser. Bound back via the
  DataBoundSetters on InteractiveInputAppearanceConfig; unchecked boxes reset to false in configure().
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Interactive Input">

    <f:entry>
      <f:checkbox field="notificationCentre"
                  title="Global notification centre (header bell)"/>
      <f:description>
        When on, a bell appears in the header. On the dashboard it lists every question you can
        answer; inside a pipeline (a job or build page) it shows only that pipeline's questions.
        Off by default so notifications surface per pipeline and per build instead of at one
        Jenkins-wide point.
      </f:description>
    </f:entry>

    <f:entry>
      <f:checkbox field="perProjectCentre"
                  title="Per-project notification centre"/>
      <f:description>
        Per-pipeline/per-build surfaces: a sidebar page on each job, an "awaiting input" badge next
        to the waiting build in the build-history list, and a per-build audit view. On by default.
      </f:description>
    </f:entry>

    <f:entry>
      <f:checkbox field="jobPageBox"
                  title="Show the inline box on the job page"/>
      <f:description>
        The large "Interactive Input" box shown on a pipeline/job page while it has a pending
        question. Turn this off to keep the badge and sidebar page without the big box. On by
        default. (Requires the per-project notification centre above.)
      </f:description>
    </f:entry>

    <f:entry title="Notification icon" field="icon">
      <f:select/>
    </f:entry>
    <f:description>
      The icon used for interactive-input notifications across the header bell, the build-history
      badge and the sidebar link.
    </f:description>

  </f:section>
</j:jelly>
