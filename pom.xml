<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>5.31</version>
    <relativePath/>
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>interactive-input</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>hpi</packaging>

  <name>Interactive Input</name>
  <description>Interactive human-in-the-loop (HITL) input for Jenkins pipelines: an in-UI notification bell and a rich approval modal for builds that pause for a human decision. Adds an askInteractive pipeline step and a versioned REST API so any external or AI agent can answer approvals programmatically, plus an opt-in bridge that surfaces existing input steps. No AI dependency at runtime.</description>
  <url>https://github.com/jenkinsci/interactive-input-plugin</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>darniss</id>
      <name>Darniss</name>
      <email>darniss.mail@gmail.com</email>
      <roles>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/jenkinsci/interactive-input-plugin.git</connection>
    <developerConnection>scm:git:git@github.com:jenkinsci/interactive-input-plugin.git</developerConnection>
    <url>https://github.com/jenkinsci/interactive-input-plugin</url>
    <tag>${scmTag}</tag>
  </scm>

  <properties>
    <!-- Verified 2026-07-19: test Jenkins server core is 2.555.2; pin to it so the HPI installs there. -->
    <jenkins.version>2.555.2</jenkins.version>
    <!-- Compile to Java 17 bytecode (built on JDK 21). -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Parent 5.31 ships maven-hpi-plugin 3.1784, which cannot parse Java 21 (class v65)
         bytecode; override to the Java-21-aware release used by bom-2.555.x. -->
    <hpi-plugin.version>3.1814.v77d15159f9b_d</hpi-plugin.version>
    <gitHubRepo>jenkinsci/interactive-input-plugin</gitHubRepo>
    <!-- Hard requirement (§7.2): modal dialog surface requires pipeline-input-step >= 560. -->
    <pipeline-input-step.version>560.v56198a_642157</pipeline-input-step.version>
    <commonmark.version>0.24.0</commonmark.version>
    <!-- commonmark is a third-party (non-plugin) library we intentionally bundle into the HPI for
         safe markdown rendering; declare it so the hpi plugin does not warn about it. -->
    <hpi.bundledArtifacts>commonmark</hpi.bundledArtifacts>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-2.555.x</artifactId>
        <version>6715.v52b_c00222d1e</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Pipeline / workflow (versions managed by BOM unless noted) -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-step-api</artifactId>
    </dependency>
    <!-- FlowNode + PauseAction for the anchored console link / "Paused" flow-graph marker (§console audit). -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-support</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-durable-task-step</artifactId>
    </dependency>

    <!-- Hard-pinned: modal dialog surface + input bridge target -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>pipeline-input-step</artifactId>
      <version>${pipeline-input-step.version}</version>
    </dependency>

    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>structs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>script-security</artifactId>
    </dependency>

    <!-- Ionicons "symbols" for the notification icon (bell/badge/sidebar). Theme-aware and the
         standard icon set across the Jenkins plugin ecosystem; version managed by the BOM. -->
    <dependency>
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>ionicons-api</artifactId>
    </dependency>

    <!-- JCasC: optional at runtime (air-gapped masters install without it) -->
    <dependency>
      <groupId>io.jenkins</groupId>
      <artifactId>configuration-as-code</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Safe markdown rendering (context + free-text preview). Raw HTML is escaped. -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>${commonmark.version}</version>
    </dependency>

    <!-- ===== test scope ===== -->
    <!-- CPS engine: only needed to author pipeline scripts in tests (CpsFlowDefinition). The plugin's
         runtime code is execution-engine agnostic (workflow-step-api only), so this is NOT a runtime
         dependency — keeping it test-scoped avoids forcing a workflow-cps floor on installs. -->
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.jenkins.configuration-as-code</groupId>
      <artifactId>test-harness</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- The org.jenkins-ci.plugins:plugin parent POM is hosted at repo.jenkins-ci.org, NOT
       Maven Central, so these must be declared here to bootstrap resolution of the parent
       POM (and Maven plugins) on a clean CI with no custom settings.xml — e.g. the CodeQL
       autobuild in the Jenkins Security Scan. This matches the standard Jenkins plugin
       archetype; a repo the parent "provides" cannot be used to download the parent itself. -->
  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
